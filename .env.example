# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web push (opsional)
VITE_VAPID_PUBLIC_KEY=

# Cloudflare R2 - domain publik bucket (BUKAN secret, aman diketahui client).
# Baru punya nilai valid setelah "Public Access" diaktifkan di dashboard Cloudflare
# untuk bucket R2 (custom domain atau r2.dev subdomain).
VITE_R2_PUBLIC_BASE_URL=

# ── Kredensial R2 di bawah ini TIDAK dipakai di file .env manapun ──
# Disimpan sebagai Edge Function secret (supabase/functions/r2-storage), lewat:
#   npx supabase secrets set R2_ACCOUNT_ID=xxx R2_ACCESS_KEY_ID=xxx \
#     R2_SECRET_ACCESS_KEY=xxx R2_BUCKET_NAME=xxx R2_PUBLIC_BASE_URL=xxx
# dijalankan di terminal sendiri - JANGAN pernah taruh nilai asli R2_SECRET_ACCESS_KEY
# di file .env yang di-load ke bundle Vite (bocor ke browser).
#
# Untuk script migrasi standalone (scripts/migrate-photos-to-r2.mjs, Node.js biasa -
# bukan Vite, jadi aman baca .env.local langsung), isi juga di .env.local (JANGAN commit):
#   R2_ACCOUNT_ID=
#   R2_ACCESS_KEY_ID=
#   R2_SECRET_ACCESS_KEY=
#   R2_BUCKET_NAME=
#   R2_PUBLIC_BASE_URL=
#   SUPABASE_SERVICE_ROLE_KEY=   (dipakai script Fase 3 buat update kolom DB)
